+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* MacGacha surround audio — https://github.com/deruta74/MacGacha */
+/* Unix-only opt-in format and endpoint namespace. */
+#ifndef MACGACHA_SURROUND_H
+#define MACGACHA_SURROUND_H
+
+#define MACGACHA_SURROUND_ENDPOINT "macgacha-surround:1:"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static inline int macgacha_surround_enabled(void)
+{
+    const char *value = getenv("MACGACHA_SURROUND");
+    return value && !strcmp(value, "1");
+}
+
+static inline unsigned int macgacha_surround_endpoint_prefix(EDataFlow flow)
+{
+    return macgacha_surround_enabled() && flow == eRender ? sizeof(MACGACHA_SURROUND_ENDPOINT) - 1 : 0;
+}
+
+static inline const char *macgacha_surround_device(const char *device)
+{
+    if (macgacha_surround_enabled() && !strncmp(device, MACGACHA_SURROUND_ENDPOINT,
+            sizeof(MACGACHA_SURROUND_ENDPOINT) - 1)) return device + sizeof(MACGACHA_SURROUND_ENDPOINT) - 1;
+    return device;
+}
+
+static inline void macgacha_surround_mix_format(WAVEFORMATEXTENSIBLE *fmt)
+{
+    /* Keep the device nominal rate; expose the Ambience Bed input layout. */
+    fmt->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    fmt->Format.nChannels = 8;
+    fmt->Format.wBitsPerSample = 32;
+    fmt->Format.nBlockAlign = 8 * sizeof(float);
+    fmt->Format.nAvgBytesPerSec = fmt->Format.nSamplesPerSec * fmt->Format.nBlockAlign;
+    fmt->Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+    fmt->Samples.wValidBitsPerSample = 32;
+    fmt->dwChannelMask = KSAUDIO_SPEAKER_7POINT1_SURROUND;
+    fmt->SubFormat = KSDATAFORMAT_SUBTYPE_IEEE_FLOAT;
+}
+
+#endif
