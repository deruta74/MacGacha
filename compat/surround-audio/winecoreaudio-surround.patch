+++ b/dlls/winecoreaudio.drv/macgacha-spatial.h
@@ -0,0 +1,288 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* MacGacha surround audio — https://github.com/deruta74/MacGacha */
+/* Unix-only. Included after Wine's stream, format and render helpers. */
+#ifndef MACGACHA_SPATIAL_H
+#define MACGACHA_SPATIAL_H
+
+static UInt32 macgacha_spatial_tracking(AudioUnit mixer, UInt32 type)
+{
+    UInt32 size = 0, value = 1;
+    Boolean writable = FALSE;
+    OSStatus status;
+
+    if (type != kSpatialMixerOutputType_Headphones) return 0;
+    status = AudioUnitGetPropertyInfo(mixer, kAudioUnitProperty_SpatialMixerEnableHeadTracking,
+        kAudioUnitScope_Global, 0, &size, &writable);
+    if (status) goto optional;
+    if (size != sizeof(value) || !writable)
+    {
+        status = kAudioUnitErr_InvalidPropertyValue;
+        goto optional;
+    }
+    status = AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatialMixerEnableHeadTracking,
+        kAudioUnitScope_Global, 0, &value, sizeof(value));
+    if (status) goto disable;
+    value = 0;
+    size = sizeof(value);
+    status = AudioUnitGetProperty(mixer, kAudioUnitProperty_SpatialMixerEnableHeadTracking,
+        kAudioUnitScope_Global, 0, &value, &size);
+    if (!status && size == sizeof(value)) return !!value;
+    if (!status) status = kAudioUnitErr_InvalidPropertyValue;
+disable:
+    /* A failed readback must not leave an unconfirmed enable request behind. */
+    value = 0;
+    if (AudioUnitSetProperty(mixer, kAudioUnitProperty_SpatialMixerEnableHeadTracking,
+        kAudioUnitScope_Global, 0, &value, sizeof(value))) value = 2;
+optional:
+    return value == 2 ? 2 : 0;
+}
+
+static void macgacha_spatial_dispose(struct coreaudio_stream *stream)
+{
+    /* Stop/uninitialize the output before disconnecting anything it can pull.
+     * This also joins callbacks when a partially started candidate fails. */
+    if (stream->unit)
+    {
+        AudioOutputUnitStop(stream->unit);
+        AudioUnitUninitialize(stream->unit);
+        AudioComponentInstanceDispose(stream->unit);
+        stream->unit = NULL;
+    }
+    if (stream->spatial_mixer)
+    {
+        AudioUnitUninitialize(stream->spatial_mixer);
+        AudioComponentInstanceDispose(stream->spatial_mixer);
+        stream->spatial_mixer = NULL;
+    }
+    free(stream->spatial_buffer);
+    stream->spatial_buffer = NULL;
+    stream->spatial_frames = 0;
+}
+
+static OSStatus macgacha_spatial_pull(void *user, AudioUnitRenderActionFlags *flags,
+        const AudioTimeStamp *ts, UInt32 bus, UInt32 nframes, AudioBufferList *data)
+{
+    struct coreaudio_stream *stream = user;
+    AudioBufferList interleaved;
+    OSStatus status;
+    UInt32 channel, frame;
+
+    if (nframes > stream->spatial_frames) return kAudioUnitErr_TooManyFramesToProcess;
+    if (!data || data->mNumberBuffers != 8) return kAudioUnitErr_FormatNotSupported;
+    for (channel = 0; channel < 8; ++channel)
+        if (data->mBuffers[channel].mNumberChannels != 1 || !data->mBuffers[channel].mData ||
+            data->mBuffers[channel].mDataByteSize < nframes * sizeof(float))
+            return kAudioUnitErr_FormatNotSupported;
+
+    /* AUSpatialMixer uses planar float. Wine retains its original interleaved
+     * ring-buffer callback, including lock, underrun silence and accounting.
+     * No allocation, property access, or logging on the real-time thread. */
+    interleaved.mNumberBuffers = 1;
+    interleaved.mBuffers[0].mNumberChannels = 8;
+    interleaved.mBuffers[0].mDataByteSize = nframes * 8 * sizeof(float);
+    interleaved.mBuffers[0].mData = stream->spatial_buffer;
+    status = ca_render_cb(stream, flags, ts, bus, nframes, &interleaved);
+    if (status) return status;
+    for (channel = 0; channel < 8; ++channel)
+    {
+        float *dst = data->mBuffers[channel].mData;
+        for (frame = 0; frame < nframes; ++frame)
+            dst[frame] = stream->spatial_buffer[frame * 8 + channel];
+        data->mBuffers[channel].mDataByteSize = nframes * sizeof(float);
+    }
+    return noErr;
+}
+
+static OSStatus macgacha_spatial_output_type(AudioDeviceID device, UInt32 *type)
+{
+    AudioObjectPropertyAddress addr = {kAudioHardwarePropertyDefaultOutputDevice,
+        kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+    AudioDeviceID current;
+    UInt32 size = sizeof(current), transport, source = 0, kind = 0;
+    OSStatus status;
+
+    status = AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, &current);
+    if (status) return status;
+    /* Don't silently send a stream selected for another endpoint to default. */
+    if (device != current) return kAudioHardwareBadDeviceError;
+    addr.mSelector = kAudioDevicePropertyTransportType;
+    size = sizeof(transport);
+    status = AudioObjectGetPropertyData(device, &addr, 0, NULL, &size, &transport);
+    if (status) return status;
+
+    addr.mSelector = kAudioDevicePropertyDataSource;
+    addr.mScope = kAudioDevicePropertyScopeOutput;
+    if (AudioObjectHasProperty(device, &addr))
+    {
+        size = sizeof(source);
+        status = AudioObjectGetPropertyData(device, &addr, 0, NULL, &size, &source);
+        if (status) return status;
+        kind = source;
+        addr.mSelector = kAudioDevicePropertyDataSourceKindForID;
+        if (AudioObjectHasProperty(device, &addr))
+        {
+            AudioValueTranslation translation = {&source, sizeof(source), &kind, sizeof(kind)};
+            size = sizeof(translation);
+            status = AudioObjectGetPropertyData(device, &addr, 0, NULL, &size, &translation);
+            if (status) return status;
+        }
+    }
+
+    /* 'hdpn'/'ispk' are built-in port data-source IDs; 'hdph'/'spkr' are
+     * terminal-kind values. Unknown Bluetooth endpoints are assumed headphones
+     * when no terminal kind is available; speaker kinds take precedence over transport. */
+    if (kind == 'hdpn' || kind == kAudioStreamTerminalTypeHeadphones)
+        *type = kSpatialMixerOutputType_Headphones;
+    else if (kind == 'ispk')
+        *type = kSpatialMixerOutputType_BuiltInSpeakers;
+    else if (kind == kAudioStreamTerminalTypeSpeaker)
+        *type = transport == kAudioDeviceTransportTypeBuiltIn ?
+            kSpatialMixerOutputType_BuiltInSpeakers : kSpatialMixerOutputType_ExternalSpeakers;
+    else if (transport == kAudioDeviceTransportTypeBluetooth || transport == kAudioDeviceTransportTypeBluetoothLE)
+        *type = kSpatialMixerOutputType_Headphones;
+    else if (transport == kAudioDeviceTransportTypeBuiltIn)
+        *type = kSpatialMixerOutputType_BuiltInSpeakers;
+    else
+        *type = kSpatialMixerOutputType_ExternalSpeakers;
+    return noErr;
+}
+
+static const char *macgacha_spatial_type_name(UInt32 type)
+{
+    switch (type)
+    {
+        case kSpatialMixerOutputType_Headphones: return "headphones";
+        case kSpatialMixerOutputType_BuiltInSpeakers: return "built-in-speakers";
+        case kSpatialMixerOutputType_ExternalSpeakers: return "external-speakers";
+        default: return "not-queried";
+    }
+}
+
+static BOOL macgacha_spatial_start(struct coreaudio_stream *stream)
+{
+    AudioComponentDescription desc = {0};
+    AudioComponent component;
+    AudioStreamBasicDescription input = {0}, output;
+    AudioChannelLayout layout = {0};
+    AudioUnitConnection connection;
+    AURenderCallbackStruct callback = {macgacha_spatial_pull, stream};
+    UInt32 type = 0, value, size;
+    HRESULT format_result;
+    OSStatus status = noErr;
+    const char *stage = "eligibility";
+
+    if (!macgacha_surround_enabled()) return FALSE;
+    if (stream->flow != eRender)
+    {
+        stage = "capture"; status = kAudioUnitErr_FormatNotSupported; goto failed;
+    }
+    format_result = ca_get_audiodesc(&input, stream->fmt);
+    /* Keep cutscene PCM/stereo and unknown masks on Wine's original path. */
+    if (stream->fmt->wFormatTag != WAVE_FORMAT_EXTENSIBLE || stream->fmt->cbSize < 22 || stream->fmt->nChannels != 8 ||
+        ((WAVEFORMATEXTENSIBLE *)stream->fmt)->dwChannelMask != 0x63f ||
+        FAILED(format_result) || input.mFormatID != kAudioFormatLinearPCM ||
+        !(input.mFormatFlags & kAudioFormatFlagIsFloat) || input.mBitsPerChannel != 32 ||
+        input.mBytesPerFrame != 8 * sizeof(float) || input.mBytesPerPacket != 8 * sizeof(float) ||
+        input.mFramesPerPacket != 1 || (input.mFormatFlags & kAudioFormatFlagIsNonInterleaved))
+    {
+        status = kAudioUnitErr_FormatNotSupported; goto failed;
+    }
+
+#define MACGACHA_AU_STEP(label, expression) do { stage = label; status = (expression); \
+    if (status) goto failed; } while (0)
+    MACGACHA_AU_STEP("output-type", macgacha_spatial_output_type(stream->dev_id, &type));
+    desc.componentType = kAudioUnitType_Output;
+    desc.componentSubType = kAudioUnitSubType_HALOutput;
+    desc.componentManufacturer = kAudioUnitManufacturer_Apple;
+    stage = "find-output";
+    if (!(component = AudioComponentFindNext(NULL, &desc)))
+    {
+        status = kAudioUnitErr_FailedInitialization;
+        goto failed;
+    }
+    MACGACHA_AU_STEP("create-output", AudioComponentInstanceNew(component, &stream->unit));
+    MACGACHA_AU_STEP("output-device", AudioUnitSetProperty(stream->unit, kAudioOutputUnitProperty_CurrentDevice,
+        kAudioUnitScope_Global, 0, &stream->dev_id, sizeof(stream->dev_id)));
+
+    desc.componentType = kAudioUnitType_Mixer;
+    desc.componentSubType = kAudioUnitSubType_SpatialMixer;
+    stage = "find-mixer";
+    if (!(component = AudioComponentFindNext(NULL, &desc)))
+    {
+        status = kAudioUnitErr_FailedInitialization;
+        goto failed;
+    }
+    MACGACHA_AU_STEP("create-mixer", AudioComponentInstanceNew(component, &stream->spatial_mixer));
+    value = 1;
+    MACGACHA_AU_STEP("one-input", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_ElementCount,
+        kAudioUnitScope_Input, 0, &value, sizeof(value)));
+
+    stream->dev_desc = input; /* Wine's accounting still describes its ring. */
+    input.mFormatFlags = kAudioFormatFlagIsFloat | kAudioFormatFlagIsPacked | kAudioFormatFlagIsNonInterleaved;
+    input.mBytesPerFrame = input.mBytesPerPacket = sizeof(float);
+    output = input;
+    output.mChannelsPerFrame = 2;
+    MACGACHA_AU_STEP("mixer-input-format", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_StreamFormat,
+        kAudioUnitScope_Input, 0, &input, sizeof(input)));
+    layout.mChannelLayoutTag = kAudioChannelLayoutTag_UseChannelBitmap;
+    layout.mChannelBitmap = 0x63f;
+    MACGACHA_AU_STEP("mixer-input-layout", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_AudioChannelLayout,
+        kAudioUnitScope_Input, 0, &layout, sizeof(layout)));
+    MACGACHA_AU_STEP("mixer-output-format", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_StreamFormat,
+        kAudioUnitScope_Output, 0, &output, sizeof(output)));
+    layout.mChannelLayoutTag = kAudioChannelLayoutTag_Stereo;
+    layout.mChannelBitmap = 0;
+    MACGACHA_AU_STEP("mixer-output-layout", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_AudioChannelLayout,
+        kAudioUnitScope_Output, 0, &layout, sizeof(layout)));
+    MACGACHA_AU_STEP("hal-input-format", AudioUnitSetProperty(stream->unit, kAudioUnitProperty_StreamFormat,
+        kAudioUnitScope_Input, 0, &output, sizeof(output)));
+    MACGACHA_AU_STEP("hal-input-layout", AudioUnitSetProperty(stream->unit, kAudioUnitProperty_AudioChannelLayout,
+        kAudioUnitScope_Input, 0, &layout, sizeof(layout)));
+    value = kSpatializationAlgorithm_UseOutputType;
+    MACGACHA_AU_STEP("algorithm", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_SpatializationAlgorithm,
+        kAudioUnitScope_Input, 0, &value, sizeof(value)));
+    value = kSpatialMixerSourceMode_AmbienceBed;
+    MACGACHA_AU_STEP("ambience-bed", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_SpatialMixerSourceMode,
+        kAudioUnitScope_Input, 0, &value, sizeof(value)));
+    MACGACHA_AU_STEP("output-type-property", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_SpatialMixerOutputType,
+        kAudioUnitScope_Global, 0, &type, sizeof(type)));
+
+    size = sizeof(stream->spatial_frames);
+    MACGACHA_AU_STEP("max-frames", AudioUnitGetProperty(stream->unit, kAudioUnitProperty_MaximumFramesPerSlice,
+        kAudioUnitScope_Global, 0, &stream->spatial_frames, &size));
+    if (!stream->spatial_frames || stream->spatial_frames > 65536)
+    {
+        stage = "frame-bound"; status = kAudioUnitErr_TooManyFramesToProcess; goto failed;
+    }
+    MACGACHA_AU_STEP("mixer-max-frames", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_MaximumFramesPerSlice,
+        kAudioUnitScope_Global, 0, &stream->spatial_frames, sizeof(stream->spatial_frames)));
+    stage = "allocate-bridge";
+    if (!(stream->spatial_buffer = malloc(stream->spatial_frames * 8 * sizeof(float))))
+    {
+        status = kAudioUnitErr_FailedInitialization;
+        goto failed;
+    }
+    MACGACHA_AU_STEP("mixer-callback", AudioUnitSetProperty(stream->spatial_mixer, kAudioUnitProperty_SetRenderCallback,
+        kAudioUnitScope_Input, 0, &callback, sizeof(callback)));
+    connection.sourceAudioUnit = stream->spatial_mixer;
+    connection.sourceOutputNumber = connection.destInputNumber = 0;
+    MACGACHA_AU_STEP("connect", AudioUnitSetProperty(stream->unit, kAudioUnitProperty_MakeConnection,
+        kAudioUnitScope_Input, 0, &connection, sizeof(connection)));
+    MACGACHA_AU_STEP("initialize-mixer", AudioUnitInitialize(stream->spatial_mixer));
+    MACGACHA_AU_STEP("initialize-output", AudioUnitInitialize(stream->unit));
+    macgacha_spatial_tracking(stream->spatial_mixer, type);
+    MACGACHA_AU_STEP("start-output", AudioOutputUnitStart(stream->unit));
+#undef MACGACHA_AU_STEP
+    fprintf(stderr, "macgacha-surround: stream output=%s channels=%u rate=%u spatial=on\n",
+        macgacha_spatial_type_name(type), (unsigned)stream->fmt->nChannels,
+        (unsigned)stream->fmt->nSamplesPerSec);
+    return TRUE;
+
+failed:
+    macgacha_spatial_dispose(stream);
+    fprintf(stderr, "macgacha-surround: stream output=%s channels=%u rate=%u spatial=fallback:%s:%d\n",
+        macgacha_spatial_type_name(type), (unsigned)stream->fmt->nChannels,
+        (unsigned)stream->fmt->nSamplesPerSec, stage, (int)status);
+    return FALSE;
+}
+#endif
