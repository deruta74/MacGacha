+static BOOL is_need_timeout_fix(void)
+{
+    static volatile char cache = -1;
+    BOOL ret = cache;
+
+    if (ret == -1)
+    {
+        const WCHAR *p, *name = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
