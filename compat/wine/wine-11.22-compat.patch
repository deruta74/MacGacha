+        .options = p3,
+        .access = p4,
+        .retkey = (UINT_PTR)p5,
+        .result = (UINT_PTR)&result,
+    };
+
+    TRACE("RegOpenKeyExA %p %s\n", p1, p2);
+
+    KeUserDispatchCallback(&params.dispatch, sizeof(params), &ret_ptr, &ret_len);
+
+    return result;
+}
