+            cache = 0;
+            return FALSE;
+        }
+
+        if ((p = wcsrchr(name, '/')))
+            name = p + 1;
+        if ((p = wcsrchr(name, '\\')))
+            name = p + 1;
+        ret = (env && atoi(env)) &&
+              (!wcsicmp(name, L"GenshinImpact.exe") || !wcsicmp(name, L"YuanShen.exe") || !wcsicmp(name, L"ZenlessZoneZero.exe"));
+        cache = ret;
+    }
+    return ret;
