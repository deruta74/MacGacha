+    if (!sidecar_handle) goto done;
+    sidecar_api = (yaagl_fsr_fg_api_fn)dlsym(sidecar_handle, "yaagl_fsr_fg_api");
+    if (!sidecar_api)
+    {
+        dlclose(sidecar_handle);
+        sidecar_handle = NULL;
+    }
+done:
+    pthread_mutex_unlock(&sidecar_mutex);
+}
