+static void load_sidecar(void)
+{
+    Dl_info info;
+    char path[PATH_MAX];
+    char *slash;
+
+    pthread_mutex_lock(&sidecar_mutex);
+    if (sidecar_api) { pthread_mutex_unlock(&sidecar_mutex); return; }
+    if (!dladdr((const void *)&load_sidecar, &info) || !info.dli_fname) goto done;
