    "Open the Game Porting Toolkit disk image from Apple, then rescan, or choose the folder that contains it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne das Disk-Image von Apples Game Porting Toolkit und suche dann erneut, oder wähle den Ordner, der es enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la imagen de disco de Game Porting Toolkit de Apple y vuelve a buscar, o elige la carpeta que la contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l'image disque de Game Porting Toolkit d'Apple, puis relancez l'analyse, ou choisissez le dossier qui la contient."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka disk image Game Porting Toolkit dari Apple, lalu pindai ulang, atau pilih folder yang berisi toolkit tersebut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleのGame Porting Toolkitのディスクイメージを開いてから再スキャンするか、それを含むフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 Game Porting Toolkit 디스크 이미지를 연 후 다시 스캔하거나, 해당 이미지가 있는 폴더를 선택해 주세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a imagem de disco do Game Porting Toolkit da Apple e procure novamente, ou escolha a pasta que a contém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте образ диска Game Porting Toolkit от Apple, затем выполните повторный поиск или выберите папку, в которой он находится."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดอิมเมจดิสก์ Game Porting Toolkit จาก Apple แล้วสแกนใหม่ หรือเลือกโฟลเดอร์ที่มีชุดเครื่องมือนั้นอยู่"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте образ диска Game Porting Toolkit від Apple, потім виконайте повторний пошук або виберіть папку, у якій він міститься."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở ảnh đĩa Game Porting Toolkit của Apple rồi quét lại, hoặc chọn thư mục chứa bộ công cụ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Apple 的 Game Porting Toolkit 磁盘映像后重新扫描，或选择包含它的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開 Apple 的 Game Porting Toolkit 磁碟映像檔後重新掃描，或選擇包含它的資料夾。"
          }
        }
      }
    },
