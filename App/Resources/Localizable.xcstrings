{
  "sourceLanguage" : "en",
  "strings" : {
    "Wine crypt32 fix" : {
      "comment" : "Runtime component name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine crypt32 修复"
          }
        }
      }
    },
    "%@ Settings" : {
      "comment" : "Sheet title; the argument is the game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 设置"
          }
        }
      }
    },
    "%@ can't be played until the install finishes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装完成前无法游玩%@。"
          }
        }
      }
    },
    "%@ closed during startup" : {
      "comment" : "The argument is the game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在启动过程中关闭"
          }
        }
      }
    },
    "%@ couldn't start" : {
      "comment" : "The argument is the game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法启动"
          }
        }
      }
    },
    "%@ files were kept aside" : {
      "comment" : "Alert title; the argument is the game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的文件已另行保存"
          }
        }
      }
    },
    "%@ is a Windows game. MacGacha runs it with these compatibility components, matched to the game's settings." : {
      "comment" : "Runtime setup sheet explanation; the argument is the game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 Windows 游戏。MacGacha 会根据该游戏的设置，使用以下兼容性组件运行游戏。"
          }
        }
      }
    },
    "%@ is downloading — pause it to start this one" : {
      "comment" : "The argument is another game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在下载 — 请先暂停再开始此游戏"
          }
        }
      }
    },
    "%@ is running" : {
      "comment" : "Quit confirmation title; the argument is the game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行"
          }
        }
      }
    },
    "%@ is running — quit it to play this one" : {
      "comment" : "The argument is another game's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行 — 请先退出再玩这款游戏"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Downloaded so far of the total, e.g. 18.3 of 136.5 GB",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ of the free space Finder shows is held by macOS (Time Machine snapshots and caches) and can't be used yet. macOS frees it over time, or you can free it in System Settings › General › Storage." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访达显示的可用空间中，有 %@ 被 macOS 占用（时间机器快照和缓存），暂时无法使用。macOS 会逐步释放，你也可以在“系统设置 › 通用 › 储存空间”中手动释放。"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "Joins two parts of a status line",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@/s" : {
      "comment" : "Download speed, e.g. 47 MB/s",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/秒"
          }
        }
      }
    },
    "A file exceeds the supported size limit. Choose another source." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有文件超出支持的大小上限。请选择其他来源。"
          }
        }
      }
    },
    "A required tool could not finish. Check Diagnostics for details." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所需的工具未能完成。详情请查看诊断信息。"
          }
        }
      }
    },
    "About %@ to download" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约需下载 %@"
