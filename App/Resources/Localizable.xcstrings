            "state" : "translated",
            "value" : "%@ 실행 중 — 이 게임을 플레이하려면 종료해 주세요"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em execução — feche-o para jogar este"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущена игра %@ — закройте её, чтобы играть в эту"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ กำลังทำงานอยู่ — โปรดปิดก่อนเล่นเกมนี้"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущено гру %@ — закрийте її, щоб грати в цю"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang chạy — hãy thoát game đó để chơi game này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行 — 请先退出再玩这款游戏"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在執行 — 請先結束再玩這款遊戲"
          }
        }
      }
    },
