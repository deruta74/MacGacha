    "If no window appears, open Terminal and run softwareupdate --install-rosetta." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls kein Fenster erscheint, öffne „Terminal“ und führe softwareupdate --install-rosetta aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no aparece ninguna ventana, abre Terminal y ejecuta softwareupdate --install-rosetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aucune fenêtre ne s'affiche, ouvrez Terminal et exécutez softwareupdate --install-rosetta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak ada jendela yang muncul, buka Terminal dan jalankan softwareupdate --install-rosetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウが表示されない場合は、ターミナルを開いて softwareupdate --install-rosetta を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창이 나타나지 않으면 터미널을 열고 softwareupdate --install-rosetta를 실행해 주세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nenhuma janela aparecer, abra o Terminal e execute softwareupdate --install-rosetta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если окно не появилось, откройте «Терминал» и выполните softwareupdate --install-rosetta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีหน้าต่างปรากฏขึ้น โปรดเปิด “เทอร์มินัล” แล้วรัน softwareupdate --install-rosetta"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вікно не з’явилося, відкрийте «Термінал» і виконайте softwareupdate --install-rosetta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không có cửa sổ nào xuất hiện, hãy mở Terminal và chạy softwareupdate --install-rosetta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有出现窗口，请打开“终端”并运行 softwareupdate --install-rosetta。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果沒有出現視窗，請打開「終端機」並執行 softwareupdate --install-rosetta。"
          }
        }
      }
    },
    "If you quit MacGacha, the game loses its connection and will need to be restarted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du MacGacha beendest, verliert das Spiel die Verbindung und muss neu gestartet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales de MacGacha, el juego perderá la conexión y tendrás que reiniciarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous quittez MacGacha, le jeu perdra sa connexion et devra être redémarré."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kamu keluar dari MacGacha, game akan kehilangan koneksinya dan perlu dimulai ulang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacGachaを終了するとゲームの接続が切れ、ゲームの再起動が必要になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacGacha를 종료하면 게임 연결이 끊어져 게임을 다시 시작해야 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você sair do MacGacha, o jogo perderá a conexão e precisará ser reiniciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если закрыть MacGacha, игра потеряет соединение, и её придётся перезапустить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณออกจาก MacGacha เกมจะขาดการเชื่อมต่อและต้องเริ่มใหม่"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо закрити MacGacha, гра втратить з’єднання, і її доведеться перезапустити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn thoát MacGacha, game sẽ mất kết nối và cần khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果退出 MacGacha，游戏会断开连接，需要重新启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果結束 MacGacha，遊戲會中斷連線，需要重新啟動。"
          }
        }
      }
    },
