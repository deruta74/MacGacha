    "That display isn't connected, so the game opens on the main display. Changes apply the next time you press Play." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Display ist nicht verbunden, daher öffnet sich das Spiel auf dem Hauptdisplay. Änderungen gelten ab dem nächsten Klick auf „Spiel starten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa pantalla no está conectada, así que el juego se abre en la pantalla principal. Los cambios se aplican la próxima vez que pulses Comenzar juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran n'est pas connecté, le jeu s'ouvre donc sur l'écran principal. Les modifications s'appliquent la prochaine fois que vous cliquez sur Démarrer."
