    "%@ is a Windows game. MacGacha runs it with these compatibility components, matched to the game's settings." : {
      "comment" : "Runtime setup sheet explanation; the argument is the game's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Windows-Spiel. MacGacha startet es mit diesen Kompatibilitätskomponenten, abgestimmt auf die Spieleinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un juego para Windows. MacGacha lo ejecuta con estos componentes de compatibilidad, adaptados a los ajustes del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un jeu Windows. MacGacha l'exécute avec ces composants de compatibilité, adaptés aux paramètres du jeu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah game Windows. MacGacha menjalankannya dengan komponen kompatibilitas berikut, sesuai pengaturan game."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はWindowsゲームです。MacGachaはゲームの設定に合わせて、以下の互換性コンポーネントでゲームを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Windows 게임입니다. MacGacha는 게임 설정에 맞춰 다음 호환성 구성 요소로 게임을 실행합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é um jogo para Windows. O MacGacha o executa com estes componentes de compatibilidade, de acordo com os ajustes do jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — игра для Windows. MacGacha запускает её с этими компонентами совместимости, подобранными под настройки игры."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เป็นเกม Windows โดย MacGacha จะรันเกมด้วยคอมโพเนนต์ความเข้ากันได้เหล่านี้ตามการตั้งค่าของเกม"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гра для Windows. MacGacha запускає її з цими компонентами сумісності, підібраними під налаштування гри."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là game Windows. MacGacha chạy game bằng các thành phần tương thích sau, phù hợp với thiết lập của game."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 Windows 游戏。MacGacha 会根据该游戏的设置，使用以下兼容性组件运行游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 Windows 遊戲。MacGacha 會依照該遊戲的設定，使用以下相容性元件執行遊戲。"
          }
        }
      }
    },
    "%@ is downloading — pause it to start this one" : {
