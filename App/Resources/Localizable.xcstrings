    "A file exceeds the supported size limit. Choose another source." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei überschreitet die unterstützte Größe. Wähle eine andere Quelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo supera el tamaño máximo admitido. Elige otro origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier dépasse la taille maximale prise en charge. Choisissez une autre source."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada file yang melebihi batas ukuran yang didukung. Pilih sumber lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされているサイズの上限を超えるファイルがあります。別のソースを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 크기 제한을 초과하는 파일이 있습니다. 다른 소스를 선택해 주세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo excede o limite de tamanho suportado. Escolha outra origem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл превышает допустимый размер. Выберите другой источник."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีไฟล์ที่มีขนาดเกินขีดจำกัดที่รองรับ โปรดเลือกแหล่งอื่น"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл перевищує допустимий розмір. Виберіть інше джерело."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có tệp vượt quá giới hạn kích thước được hỗ trợ. Hãy chọn nguồn khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有文件超出支持的大小上限。请选择其他来源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
