    "Sharper, but much heavier on the GPU." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schärfer, aber deutlich höhere GPU-Last."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más nítido, pero exige mucho más a la GPU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus net, mais beaucoup plus exigeant pour le GPU."
          }
        },
        "id" : {
